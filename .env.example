APP_NAME=catalog-service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
APP_ROOT_PATH=/catalog
HOST=0.0.0.0
PORT=8002
GRPC_HOST=0.0.0.0
GRPC_PORT=50054
GRPC_VENUE_SERVICE_HOST=venue-service
GRPC_VENUE_SERVICE_PORT=50052
GRPC_ORDER_SERVICE_HOST=order-service
GRPC_ORDER_SERVICE_PORT=50051
GRPC_STARTUP_CHECK_TIMEOUT=5
GRPC_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
GRPC_CIRCUIT_BREAKER_RESET_TIMEOUT=30
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/db_catalog
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
LOG_LEVEL=INFO
LOG_FORMAT=json
